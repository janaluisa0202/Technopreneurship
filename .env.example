# Copy to .env.local (git-ignored). Every VITE_ value is PUBLIC: it is compiled into the browser bundle.
# Never put a secret key (sb_secret_...), a service_role key, a database password or an admin
# credential here or anywhere in src/. The app refuses to start in live mode if it detects one.

# demo (default): bundled illustrative data, no network requests, no Supabase needed.
# live: reads/writes the Supabase project below. If configuration or loading fails, the app shows
#       an error with retry — it never silently falls back to demo data.
VITE_SAKAYWISE_DATA_MODE=demo

# Required only when VITE_SAKAYWISE_DATA_MODE=live
# Project URL: Supabase dashboard -> Project Settings -> Data API (local CLI: http://127.0.0.1:54321)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...): Project Settings -> API Keys.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Legacy alternative if your project still uses JWT keys: the "anon" public key.
# VITE_SUPABASE_ANON_KEY=
